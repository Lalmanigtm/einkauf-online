{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",

    "resolveJsonModule": true,
    "noUnusedLocals":true,
    "noUnusedParameters": 
    true
  },

  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
